
@startuml
title Strategy Pattern - Diff Algorithms

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

top to bottom direction

abstract class DiffAlgorithm {
    +compare(original: vector<string>, modified: vector<string>): DiffResult
}

class LCSAlgorithm {
    +compare(original: vector<string>, modified: vector<string>): DiffResult
}

class MyersAlgorithm {
    +compare(original: vector<string>, modified: vector<string>): DiffResult
}

class DiffEngine {
    -algorithm: DiffAlgorithm
    +setAlgorithm(algorithm: DiffAlgorithm): void
    +compare(original: vector<string>, modified: vector<string>): DiffResult
}

DiffAlgorithm <|-- LCSAlgorithm
DiffAlgorithm <|-- MyersAlgorithm

DiffEngine o-- DiffAlgorithm

@enduml
